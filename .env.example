# Bharat Leads — env template. Copy to .env.local and fill in.

# ---- Core ----
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND=Bharat Leads

# ---- Database (Supabase) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Redis (Upstash) ----
REDIS_URL=redis://localhost:6379

# ---- Razorpay ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER_MONTHLY=
RAZORPAY_PLAN_STARTER_ANNUAL=
RAZORPAY_PLAN_GROWTH_MONTHLY=
RAZORPAY_PLAN_GROWTH_ANNUAL=
RAZORPAY_PLAN_SCALE_MONTHLY=
RAZORPAY_PLAN_SCALE_ANNUAL=
RAZORPAY_PLAN_AGENCY_MONTHLY=
RAZORPAY_PLAN_AGENCY_ANNUAL=

# ---- MSG91 ----
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=BHRTLD
MSG91_DLT_TE_ID=

# ---- AiSensy ----
AISENSY_API_KEY=
AISENSY_WEBHOOK_TOKEN=
AISENSY_OTP_CAMPAIGN=otp_fallback
AISENSY_COLD_OUTREACH_CAMPAIGN=cold_outreach_v1

# ---- Anthropic + OpenAI ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Geoapify ----
GEOAPIFY_API_KEY=

# ---- Email ----
RESEND_API_KEY=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=ap-south-1
EMAIL_FROM=hello@bharatleads.in

# ---- GST ----
GST_VALIDATION_API_KEY=
ORG_BILLING_STATE_CODE=29  # Karnataka

# ---- Observability ----
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

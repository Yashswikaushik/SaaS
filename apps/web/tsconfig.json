{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@bharat/ai": ["../../packages/ai/src"],
      "@bharat/ai/*": ["../../packages/ai/src/*"],
      "@bharat/aisensy": ["../../packages/aisensy/src"],
      "@bharat/aisensy/*": ["../../packages/aisensy/src/*"],
      "@bharat/db": ["../../packages/db/src"],
      "@bharat/db/*": ["../../packages/db/src/*"],
      "@bharat/dpdp": ["../../packages/dpdp/src"],
      "@bharat/dpdp/*": ["../../packages/dpdp/src/*"],
      "@bharat/gst": ["../../packages/gst/src"],
      "@bharat/gst/*": ["../../packages/gst/src/*"],
      "@bharat/msg91": ["../../packages/msg91/src"],
      "@bharat/msg91/*": ["../../packages/msg91/src/*"],
      "@bharat/razorpay": ["../../packages/razorpay/src"],
      "@bharat/razorpay/*": ["../../packages/razorpay/src/*"],
      "@bharat/scraper": ["../../packages/scraper/src"],
      "@bharat/scraper/*": ["../../packages/scraper/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
